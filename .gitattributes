# Normalización de fin de línea: el repositorio guarda LF y Git lo adapta al sistema.
* text=auto eol=lf

# Los scripts de Windows PowerShell necesitan CRLF y BOM para que 5.1 los lea bien.
*.ps1 text eol=crlf

# Binarios: nunca convertir.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.zip binary
*.gpkg binary
*.pbf binary
*.tif binary
*.woff binary
*.woff2 binary

# Archivos generados: no cuentan en las estadísticas de lenguaje ni en los diffs de revisión.
data-catalog/** linguist-generated=true
pnpm-lock.yaml linguist-generated=true

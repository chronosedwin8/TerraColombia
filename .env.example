# ─── Base de datos ────────────────────────────────────────────────────────────
# PostgreSQL 16+ con PostGIS 3.4+
DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5432/terracolombia
# Usuario de solo lectura para la GeoAPI pública (opcional)
DATABASE_URL_RO=

# ─── Cola / caché ─────────────────────────────────────────────────────────────
# Si se deja vacío, el worker usa una cola en memoria (solo desarrollo).
REDIS_URL=

# ─── Almacenamiento de objetos (S3 compatible) ────────────────────────────────
# Si S3_ENDPOINT queda vacío, se usa almacenamiento en disco local (./storage).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=terracolombia
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Ruta del almacén local. Si es relativa, se resuelve contra la raíz del monorepo,
# no contra el directorio desde el que se lance cada proceso.
STORAGE_LOCAL_DIR=./storage

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=CHANGEME-usar-32-bytes-aleatorios
JWT_REFRESH_SECRET=CHANGEME-otro-secreto-distinto
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Teselas ──────────────────────────────────────────────────────────────────
# vacío = la API sirve MVT con ST_AsMVT; si se define, se hace proxy a Martin
MARTIN_URL=

# ─── IA (asistente) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Pagos ────────────────────────────────────────────────────────────────────
# mercadopago (principal) | wompi | payu | epayco | mock (desarrollo)
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
# Tolerancia del desfase de reloj al validar la firma x-signature del webhook, en segundos.
MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS=300
# Adaptadores alternativos
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=
PAYU_API_KEY=
PAYU_API_LOGIN=
PAYU_BASE_URL=
PAYU_CHECKOUT_URL=
PAYU_SIGNATURE_ALGORITHM=SHA256
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_P_CUST_ID_CLIENTE=
EPAYCO_P_KEY=
EPAYCO_TEST=true
EPAYCO_BASE_URL=
# Solo para el proveedor de desarrollo (PAYMENT_PROVIDER=mock)
MOCK_WEBHOOK_SECRET=
MOCK_CHECKOUT_URL=

# ─── ETL ──────────────────────────────────────────────────────────────────────
ETL_USER_AGENT=TerraColombia/0.1 (+https://terracolombia.co; contacto@terracolombia.co)
ETL_CONCURRENCY=2
ETL_PILOT_DEPARTMENT=08
GDAL_OGR2OGR=
OSM2PGSQL=
TIPPECANOE=

# ─── Informes ─────────────────────────────────────────────────────────────────
# Estilo de mapa base para los mapas estáticos del PDF. Sin él, el informe usa el
# respaldo SVG y lo declara visiblemente con la etiqueta "SIN MAPA BASE".
MAPLIBRE_STYLE_URL=
# Ruta a un Chromium propio. Vacío = el que instala `pnpm exec playwright install chromium`.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# ─── Observabilidad ───────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Docker Compose (infra/) ───────────────────────────────────────────────────
# Solo se usan si levantas los contenedores de infra/. El Postgres nativo del equipo
# no los necesita. El PostGIS del contenedor usa 55432 para no chocar con el nativo.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=terracolombia
POSTGRES_PORT=55432
CI_POSTGRES_PORT=55433
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_CONSOLE_URL=http://localhost:9001
S3_RAW_EXPIRE_DAYS=90
MARTIN_PORT=3010
MARTIN_POOL_SIZE=10
MARTIN_LOG_LEVEL=info
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
GRAFANA_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ─── Respaldos ────────────────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_JOBS=4
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=terracolombia/backups
BACKUP_S3_KMS_KEY_ID=

# ─── Worker ───────────────────────────────────────────────────────────────────
# Colas que atiende este proceso. Permite desplegar la misma imagen con roles distintos.
WORKER_QUEUES=etl,reports,analysis,alerts
WORKER_METRICS_PORT=9100
# Token para proteger /metrics si queda expuesto fuera de la red interna.
METRICS_TOKEN=

# ─── Frontend (apps/web, prefijo VITE_) ───────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_BASEMAP_STYLE_URL=
VITE_TILES_URL=http://localhost:3001/api/v1/tiles
VITE_SENTRY_DSN=

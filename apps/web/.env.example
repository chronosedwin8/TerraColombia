# ── Frontend (@terracolombia/web) ───────────────────────────────────────────────
# Copia este archivo a `.env.local`. Solo variables con prefijo VITE_ llegan al navegador:
# nunca pongas secretos aquí.

# Base del API interno. En desarrollo el proxy de Vite reenvía /api a http://localhost:3001.
VITE_API_BASE_URL=/api/v1

# Estilo MapLibre del mapa base. Debe apuntar a teselas vectoriales propias (Protomaps/PMTiles)
# o a un servidor de estilos propio. PROHIBIDO usar teselas de Google (PLAN.md §3).
# Si se deja vacío, `src/map/style.ts` cae al estilo público de demostración de MapLibre,
# que sirve solo para desarrollo.
VITE_BASEMAP_STYLE_URL=

# Alternativa a la anterior: plantilla de teselas vectoriales propias. Si se define (y no hay
# style.json propio), `src/map/style.ts` construye el estilo mínimo sobre el esquema Protomaps v3.
# Ejemplo: https://tiles.terracolombia.co/basemap/{z}/{x}/{y}.mvt
VITE_BASEMAP_TILES_URL=

# Plantilla de teselas vectoriales servidas por el API (Martin detrás del proxy de plan).
VITE_TILES_BASE_URL=/api/v1/tiles

# Documentación pública de la API (apps/docs-site).
VITE_DOCS_URL=http://localhost:4173

# Forzar el banner rojo "DATOS DE DEMOSTRACIÓN" incluso si la API no marca meta.synthetic.
VITE_FORCE_DEMO_BANNER=false

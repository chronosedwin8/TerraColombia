{
  "//": "Solo para los archivos de configuración (Node), que no forman parte del bundle del navegador.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}

{
  "name": "@terracolombia/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "etl": "tsx src/cli/etl.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@terracolombia/db": "workspace:*",
    "@terracolombia/etl-config": "workspace:*",
    "@terracolombia/geo": "workspace:*",
    "@terracolombia/reports": "workspace:*",
    "@terracolombia/scoring": "workspace:*",
    "@terracolombia/shared": "workspace:*",
    "@terracolombia/sources": "workspace:*",
    "bullmq": "^5.34.5",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}

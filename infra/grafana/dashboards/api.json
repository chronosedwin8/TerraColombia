{
  "uid": "tc-api",
  "title": "TerraColombia · API y rendimiento",
  "description": "Objetivos del PLAN §13: ficha de predio < 800 ms p95, tesela < 200 ms p95, análisis de zona (≤5 km²) < 5 s. Los umbrales de color de los paneles son exactamente esos valores.",
  "tags": ["terracolombia", "api", "rendimiento"],
  "timezone": "America/Bogota",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "ruta",
        "label": "Ruta",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
        "query": "label_values(http_request_duration_seconds_bucket{job=\"api\"}, route)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "Todas", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Objetivos de rendimiento (PLAN §13)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ficha de predio · p95",
      "description": "Objetivo: < 800 ms. Es la pantalla central del producto.",
      "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tc_parcel_card_duration_seconds_bucket{job=\"api\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.6 },
              { "color": "red", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tesela · p95",
      "description": "Objetivo: < 200 ms con caché caliente.",
      "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tc_tile_duration_seconds_bucket{job=\"api\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.15 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Análisis de zona ≤ 5 km² · p95",
      "description": "Objetivo: < 5 s. Por encima de 5 km² el análisis es asíncrono y no tiene objetivo interactivo.",
      "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tc_area_analysis_duration_seconds_bucket{job=\"api\",area_bucket=\"le5km2\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3.5 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Errores 5xx",
      "description": "Porcentaje de peticiones con respuesta 5xx. La alerta salta en 2 %.",
      "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"api\",status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{job=\"api\"}[$__rate_interval])), 0.001)",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.02 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Tráfico HTTP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Peticiones por segundo, por código de respuesta",
      "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(http_requests_total{job=\"api\"}[$__rate_interval]))",
          "legendFormat": "{{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 25, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "5.." }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byRegexp", "options": "4.." }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byRegexp", "options": "2.." }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Latencia por ruta (p95)",
      "description": "Filtrable por ruta con la variable de arriba.",
      "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"api\",route=~\"$ruta\"}[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["max", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Percentiles globales de la API",
      "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[$__rate_interval])))", "legendFormat": "p99" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Consultas SQL más costosas",
      "description": "De pg_stat_statements. Es el primer sitio donde mirar cuando la ficha de predio se pone lenta.",
      "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, pg_stat_statements_top_segundos_media)",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 4 },
        "overrides": []
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": true }] },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "servicio": true, "instance": true, "proyecto": true, "entorno": true }, "renameByName": { "consulta": "Consulta", "Value": "Segundos (media)" } } }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Teselas",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Latencia de teselas: acierto vs. fallo de caché",
      "description": "Si solo el fallo de caché es lento, el problema está en PostGIS o en las funciones analytics.tile_*. Si también el acierto, está en Redis o en la red.",
      "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, cache) (rate(tc_tile_duration_seconds_bucket{job=\"api\"}[$__rate_interval])))", "legendFormat": "p95 · caché={{cache}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.2 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Teselas por segundo, por capa",
      "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "sum by (layer) (rate(tc_tile_duration_seconds_count{job=\"api\"}[$__rate_interval]))", "legendFormat": "{{layer}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 30, "stacking": { "mode": "normal" }, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 23,
      "type": "gauge",
      "title": "Acierto de caché de teselas",
      "description": "Por debajo de 70 % sostenido salta una alerta: puede ser un despliegue reciente o raspado masivo.",
      "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(tc_tile_duration_seconds_count{job=\"api\",cache=\"hit\"}[$__rate_interval])) / clamp_min(sum(rate(tc_tile_duration_seconds_count{job=\"api\"}[$__rate_interval])), 0.001)", "legendFormat": "acierto" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "green", "value": 0.85 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Cuotas, abuso y dependencias",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Peticiones rechazadas (429) y cuotas agotadas",
      "description": "Distinguir abuso de un plan mal dimensionado: ver docs/SEGURIDAD.md §Anti-scraping antes de bloquear a nadie.",
      "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{job=\"api\",status_code=\"429\"}[$__rate_interval]))", "legendFormat": "429 (límite de peticiones)" },
        { "refId": "B", "expr": "sum(rate(tc_tile_quota_exceeded_total{job=\"api\"}[$__rate_interval]))", "legendFormat": "cuota de teselas agotada" },
        { "refId": "C", "expr": "sum(rate(tc_area_quota_exceeded_total{job=\"api\"}[$__rate_interval]))", "legendFormat": "cuota de área agotada" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "PostgreSQL: conexiones y transacciones",
      "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 33 },
      "targets": [
        { "refId": "A", "expr": "sum(pg_stat_activity_count{datname=\"terracolombia\"})", "legendFormat": "conexiones" },
        { "refId": "B", "expr": "max(pg_settings_max_connections)", "legendFormat": "máximo" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "máximo" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Redis: memoria usada",
      "description": "La política es noeviction: al llegar al máximo, Redis rechaza escrituras y el ETL falla.",
      "datasource": { "type": "prometheus", "uid": "prometheus-tc" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 33 },
      "targets": [
        { "refId": "A", "expr": "redis_memory_used_bytes", "legendFormat": "usada" },
        { "refId": "B", "expr": "redis_memory_max_bytes", "legendFormat": "máxima" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "máxima" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ]
}

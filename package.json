{
  "name": "terracolombia",
  "private": true,
  "version": "0.1.0",
  "description": "Motor de inteligencia territorial de Colombia",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "ui:audit": "node infra/scripts/ui-audit.mjs",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @terracolombia/db migrate",
    "db:seed": "pnpm --filter @terracolombia/db seed",
    "db:reset": "pnpm --filter @terracolombia/db reset",
    "db:boundaries": "pnpm --filter @terracolombia/db load:boundaries",
    "catalog:crawl": "pnpm --filter @terracolombia/sources crawl",
    "catalog:report": "pnpm --filter @terracolombia/sources report",
    "etl": "pnpm --filter @terracolombia/worker etl",
    "format": "prettier --write \"**/*.{ts,vue,json,md,sql}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1"
  }
}

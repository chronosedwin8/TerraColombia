// Prisma gestiona EXCLUSIVAMENTE el esquema `app` (regla 8 de CLAUDE.md).
// Los esquemas raw/core/ctx/analytics/meta se gestionan con migraciones SQL versionadas
// en packages/db/migrations, porque llevan geometría y hay que controlar índices y particiones.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app"]
}

// ─── Identidad ────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  /// Hash argon2id. Nulo si el usuario solo entra por OAuth.
  passwordHash  String?   @map("password_hash")
  /// Nombre para mostrar. Dato de la cuenta, no de un predio.
  displayName   String?   @map("display_name")
  locale        String    @default("es-CO")
  /// user | admin | support
  role          String    @default("user")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  memberships   Membership[]
  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  projects      Project[]
  reports       Report[]
  usageEvents   UsageEvent[]
  auditLogs     AuditLog[]
  savedSearches SavedSearch[]
  alerts        Alert[]

  @@map("user")
  @@schema("app")
}

model OAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String
  providerUserId String   @map("provider_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_account")
  @@schema("app")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Hash SHA-256 del token. Nunca se guarda el token en claro.
  tokenHash  String    @unique @map("token_hash")
  /// Familia de rotación: si se reutiliza un token revocado, se invalida toda la familia.
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent")
  ipHash     String?   @map("ip_hash")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_token")
  @@schema("app")
}

model Organization {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  /// NIT de la empresa. Dato de persona jurídica, no personal.
  taxId        String?  @map("tax_id")
  /// Marca blanca para planes Business+: { logoUrl, primaryColor, footerText }
  branding     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships   Membership[]
  subscriptions Subscription[]
  apiKeys       ApiKey[]
  creditLedger  CreditLedgerEntry[]
  payments      Payment[]
  projects      Project[]
  reports       Report[]
  invoices      Invoice[]

  @@map("organization")
  @@schema("app")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// owner | admin | member | viewer
  role           String   @default("member")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("membership")
  @@schema("app")
}

// ─── Planes, suscripciones y créditos ─────────────────────────────────────────

model Plan {
  /// free | per_report | pro | business | api | enterprise (ver packages/shared/src/plans.ts)
  code            String   @id
  name            String
  monthlyPriceCop Int?     @map("monthly_price_cop")
  unitPriceCop    Int?     @map("unit_price_cop")
  monthlyCredits  Int      @default(0) @map("monthly_credits")
  /// Espejo de `Entitlements` de packages/shared. La fuente de verdad es el código;
  /// esta columna permite ajustar un plan para un cliente sin desplegar.
  entitlements    Json     @default("{}")
  isPublic        Boolean  @default(true) @map("is_public")
  sortOrder       Int      @default(100) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plan")
  @@schema("app")
}

model Subscription {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  planCode           String    @map("plan_code")
  /// trialing | active | past_due | canceled | expired
  status             String    @default("active")
  currentPeriodStart DateTime  @map("current_period_start")
  currentPeriodEnd   DateTime  @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at")
  /// Referencia de la suscripción en el proveedor de pagos
  providerRef        String?   @map("provider_ref")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planCode], references: [code])

  @@index([organizationId, status])
  @@map("subscription")
  @@schema("app")
}

model CreditLedgerEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Positivo = recarga, negativo = consumo. El saldo es la suma; nunca se sobreescribe.
  delta          Int
  /// grant_monthly | purchase | debit_report | debit_analysis | debit_location_intel |
  /// debit_export | debit_api | refund | adjustment
  reason         String
  /// Operación de CREDIT_COST que originó el consumo, si aplica
  operation      String?
  /// Referencia al objeto que consumió (reportId, jobId…)
  refId          String?  @map("ref_id")
  /// Clave de idempotencia: impide cobrar dos veces la misma operación
  idempotencyKey String?  @unique @map("idempotency_key")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("credit_ledger")
  @@schema("app")
}

// ─── Pagos ────────────────────────────────────────────────────────────────────

model Payment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// wompi | mercadopago | payu | epayco | mock
  provider       String
  /// Referencia interna que se envía al proveedor y vuelve en el webhook
  reference      String    @unique
  providerTxId   String?   @map("provider_tx_id")
  amountCop      Int       @map("amount_cop")
  currency       String    @default("COP")
  /// pending | approved | declined | voided | error | refunded
  status         String    @default("pending")
  /// card | pse | nequi | bancolombia_transfer | other
  method         String?
  /// subscription | report | credits
  purpose        String
  /// Objeto que se compró (reportId, planCode, paquete de créditos)
  purposeRef     String?   @map("purpose_ref")
  /// Respuesta del proveedor, sin datos de tarjeta
  providerPayload Json     @default("{}") @map("provider_payload")
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status])
  @@map("payment")
  @@schema("app")
}

/// Eventos de webhook procesados. Garantiza idempotencia (PLAN §12).
model WebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String
  /// Id del evento en el proveedor: clave natural de idempotencia
  eventId     String   @map("event_id")
  eventType   String   @map("event_type")
  signatureOk Boolean  @map("signature_ok")
  processedAt DateTime? @map("processed_at")
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("webhook_event")
  @@schema("app")
}

model Invoice {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Puerto InvoiceProvider: la facturación electrónica va por un tercero (PLAN §12)
  provider       String   @default("none")
  providerRef    String?  @map("provider_ref")
  number         String?
  amountCop      Int      @map("amount_cop")
  /// draft | issued | sent | failed
  status         String   @default("draft")
  issuedAt       DateTime? @map("issued_at")
  pdfKey         String?  @map("pdf_key")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invoice")
  @@schema("app")
}

// ─── Llaves de API ────────────────────────────────────────────────────────────

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  /// Prefijo visible (tc_live_xxxx) para que el usuario identifique la llave
  prefix         String    @unique
  /// Hash argon2id del secreto. El secreto se muestra una sola vez al crearla.
  keyHash        String    @map("key_hash")
  /// sandbox | live
  environment    String    @default("sandbox")
  /// Restricción opcional por origen o IP
  allowedOrigins String[]  @default([]) @map("allowed_origins")
  scopes         String[]  @default([])
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_key")
  @@schema("app")
}

// ─── Trabajo del usuario ──────────────────────────────────────────────────────

model Project {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String
  description    String?
  color          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedAreas   SavedArea[]
  savedParcels SavedParcel[]
  reports      Report[]

  @@index([organizationId])
  @@map("project")
  @@schema("app")
}

model SavedArea {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  /// Geometría GeoJSON. Se guarda como JSON porque es dato de aplicación, no capa servida.
  geometry  Json
  /// polygon | radius | municipality | isochrone
  kind      String
  areaKm2   Decimal? @map("area_km2") @db.Decimal(14, 4)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("saved_area")
  @@schema("app")
}

model SavedParcel {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  npn       String   @db.Char(30)
  muniCode  String   @map("muni_code") @db.Char(5)
  label     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, npn])
  @@map("saved_parcel")
  @@schema("app")
}

model SavedSearch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  /// DSL de ParcelQuerySchema, validado antes de guardar
  query     Json
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_search")
  @@schema("app")
}

// ─── Informes ─────────────────────────────────────────────────────────────────

model Report {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  /// parcel | area | location_intel | change | municipality
  kind           String
  /// resumen | completo | tecnico
  level          String    @default("completo")
  title          String
  /// Objeto del informe: npn, geometría, plantilla…
  subject        Json
  /// queued | running | done | failed
  status         String    @default("queued")
  progress       Int       @default(0)
  errorMessage   String?   @map("error_message")
  /// Los informes son INMUTABLES: se guarda el snapshot_id de cada dataset usado.
  /// { datasetId: { snapshotId, cutDate, license, attribution } }
  sourceSnapshots Json     @default("{}") @map("source_snapshots")
  /// Token del QR de verificación
  verifyToken    String?   @unique @map("verify_token")
  creditsCharged Int       @default(0) @map("credits_charged")
  /// Claves en el almacén de objetos por formato: { pdf: "...", xlsx: "..." }
  artifacts      Json      @default("{}")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sections     ReportSection[]

  @@index([organizationId, createdAt])
  @@index([status])
  @@map("report")
  @@schema("app")
}

model ReportSection {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  /// Número de sección (1–10 en el Informe Territorial de Predio)
  ordinal   Int
  key       String
  title     String
  /// Datos ya calculados de la sección, con su procedencia
  payload   Json     @default("{}")
  /// true si la sección no pudo llenarse por falta de datos (se declara, no se rellena)
  isMissing Boolean  @default(false) @map("is_missing")
  createdAt DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, ordinal])
  @@map("report_section")
  @@schema("app")
}

// ─── Alertas ──────────────────────────────────────────────────────────────────

model Alert {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  name           String
  /// new_parcels | parcel_changed | new_buildings | area_change | indicator_threshold
  kind           String
  /// Ámbito vigilado: { muniCode } o { geometry } o { npn }
  scope          Json
  /// Condición: { indicator, operator, value } cuando aplique
  condition      Json      @default("{}")
  /// daily | weekly | monthly | on_new_cut
  frequency      String    @default("on_new_cut")
  channels       String[]  @default(["email"])
  isActive       Boolean   @default(true) @map("is_active")
  lastCheckedAt  DateTime? @map("last_checked_at")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries    AlertDelivery[]

  @@index([userId, isActive])
  @@map("alert")
  @@schema("app")
}

model AlertDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  alertId   String   @map("alert_id") @db.Uuid
  /// Resumen de lo detectado, ya con procedencia
  payload   Json     @default("{}")
  channel   String
  /// pending | sent | failed
  status    String   @default("pending")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt])
  @@map("alert_delivery")
  @@schema("app")
}

// ─── Uso, cuotas y auditoría ──────────────────────────────────────────────────

model UsageEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  apiKeyId       String?  @map("api_key_id") @db.Uuid
  /// search | parcel_detail | parcel_query | area_analyze | suitability |
  /// location_intel | report | export | tile | ai_ask
  operation      String
  /// web | api
  channel        String   @default("web")
  /// Créditos consumidos por el evento
  credits        Int      @default(0)
  /// Unidades de la operación: filas devueltas, km² analizados, teselas servidas…
  units          Decimal? @db.Decimal(16, 4)
  durationMs     Int?     @map("duration_ms")
  statusCode     Int?     @map("status_code")
  /// Contexto sin PII: { muniCode, layer, format… }
  detail         Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([operation, createdAt])
  @@map("usage_event")
  @@schema("app")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  /// login | logout | plan_change | api_key_created | api_key_revoked |
  /// etl_run_triggered | snapshot_published | user_role_changed | data_export
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  /// Hash de la IP, no la IP: registro sin datos personales innecesarios
  ipHash     String?  @map("ip_hash")
  userAgent  String?  @map("user_agent")
  detail     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
  @@schema("app")
}

/// Trabajos asíncronos: análisis pesados, informes, corridas de ETL.
/// Espejo consultable de la cola (BullMQ o cola en memoria, ADR-004).
model Job {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  /// area_analyze | report | export | location_intel | change_compare | etl
  kind           String
  /// queued | running | done | failed | canceled
  status         String    @default("queued")
  progress       Int       @default(0)
  /// Mensaje de progreso en español para mostrar al usuario
  progressMessage String?  @map("progress_message")
  input          Json      @default("{}")
  result         Json?
  errorMessage   String?   @map("error_message")
  attempts       Int       @default(0)
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([organizationId, createdAt])
  @@map("job")
  @@schema("app")
}

/// Cuotas consumidas por periodo. Evita recorrer usage_event en cada petición.
model QuotaCounter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Periodo AAAA-MM o AAAA-MM-DD según la cuota
  period         String
  metric         String
  used           Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, period, metric])
  @@map("quota_counter")
  @@schema("app")
}
